# Zenthra AI
AI_PROVIDER=google
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Data providers
COINGECKO_API_KEY=
SOLANA_RPC_URL=
NODE_ENV=development

# Persistence (see src/db/client.ts)
# Leave DATABASE_URL empty to use local SQLite at DATABASE_PATH (zero-config
# dev/Replit default). Set DATABASE_URL to a real Postgres connection
# string for production (e.g. Vercel, where local SQLite does not persist).
DATABASE_PATH=./data/zenthra.db
DATABASE_URL=
DATABASE_SSL=

# Pricing (plans are hidden from /api/pricing/plans until priced > 0)
PLAN_PRO_PRICE_IDR=
PLAN_PRO_PLUS_PRICE_IDR=

# QRIS (static/manual — see app/api/payment/checkout/route.ts)
QRIS_STATIC_IMAGE_URL=
QRIS_MERCHANT_NAME=

# Telegram admin bot (admin interface only, never source of truth)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Admin API fallback (x-admin-secret header) — also required to view a
# payment proof file via GET /api/admin/proof/[orderId], since proof files
# have no public URL (see app/api/payment/upload-proof/route.ts).
ADMIN_API_SECRET=
